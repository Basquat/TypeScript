# Conexão com o MySQL (banco criado pelo psicogest.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psicogest

# Obrigatórios em produção. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 64 caracteres hexadecimais (32 bytes). Criptografa as anotações das sessões.
# Se perder esta chave, as anotações antigas não poderão ser lidas — faça backup dela.
NOTES_KEY=
